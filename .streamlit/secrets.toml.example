# .streamlit/secrets.toml.example
# Rename this file to secrets.toml in your local .streamlit/ folder or configure on Streamlit Cloud

# (Optional) OpenWeatherMap API Key for live weather (AgriSense automatically falls back to Open-Meteo if not provided)
OPENWEATHERMAP_API_KEY = "your_openweathermap_api_key_here"

# (Optional) OpenAI API Key for dynamic grounded responses (AgriSense uses built-in localized rule engine if not provided)
OPENAI_API_KEY = "your_openai_api_key_here"
