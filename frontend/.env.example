# Backend API base URL
# For local development: http://127.0.0.1:8000
# For production on Vercel: set to your deployed backend URL (e.g., https://your-backend.onrender.com)
VITE_API_URL=http://127.0.0.1:8000

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Leave blank to use built-in 1-click Google instant sign-in for development
VITE_GOOGLE_CLIENT_ID=
